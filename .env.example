# jenkins-mcp — environment configuration template
#
# IMPORTANT: jenkins-mcp does NOT auto-load a .env file (env-only, no dotenv
# source in v1). This file is a reference for the values you need to supply.
# Use it in one of two ways:
#
#   1. (Recommended) Copy these values into the `env` block of your MCP client
#      config (see README.md → "Client configuration"). The MCP host injects
#      them into the server process.
#
#   2. For local smoke testing from a shell, export them yourself, e.g.:
#         set -a; source .env; set +a
#      (or `export` each line manually) before launching the server.
#
# Never commit a real filled-in copy of this file. `.env` is a working copy —
# add it to your global gitignore or keep it out of the repo.

# --- Required -------------------------------------------------------------

# Base URL of the target Jenkins instance. No trailing slash.
JENKINS_URL=https://ci.example.com

# Jenkins username the API token below belongs to.
JENKINS_USER=your-jenkins-username

# API token for JENKINS_USER — NOT the account password.
# Create one at: Jenkins → your user → Configure → API Token → Add new Token.
JENKINS_API_TOKEN=your-jenkins-api-token

# --- Optional -------------------------------------------------------------

# Log verbosity on stderr: debug | info | warn | error. Default: info.
# Set to debug to see crumb-fetch / cookie-reuse detail while diagnosing
# connectivity. Secrets (token/crumb/cookie values) are always redacted.
# LOG_LEVEL=info
