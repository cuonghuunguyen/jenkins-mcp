{
  "name": "jenkins-mcp-monorepo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Jenkins integration for AI coding agents - core library, MCP server and CLI",
  "license": "MIT",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "biome check packages/*/src",
    "format": "biome format --write packages/*/src",
    "clean": "turbo run clean && rm -rf node_modules/.cache/turbo",
    "dev:mcp": "pnpm --filter @cuonghuunguyen/jenkins-mcp dev",
    "cli": "pnpm --filter @cuonghuunguyen/jenkins-cli dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.0",
    "turbo": "^2.10.11",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
