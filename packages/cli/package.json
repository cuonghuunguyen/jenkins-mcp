{
  "name": "@cuonghuunguyen/jenkins-cli",
  "version": "0.2.0",
  "type": "module",
  "description": "jenkins CLI - the same Jenkins operations the MCP server exposes, at a shell",
  "keywords": [
    "jenkins",
    "cli",
    "ci",
    "build",
    "devops"
  ],
  "homepage": "https://github.com/cuonghuunguyen/jenkins-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cuonghuunguyen/jenkins-mcp.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/cuonghuunguyen/jenkins-mcp/issues",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "jenkins": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cuonghuunguyen/jenkins-core": "workspace:*",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/yargs": "^17.0.33",
    "tsx": "^4.23.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
