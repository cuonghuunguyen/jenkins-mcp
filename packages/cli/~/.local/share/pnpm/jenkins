#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/chnguyen/ai/jenkins-mcp/packages/cli/dist/node_modules:/home/chnguyen/ai/jenkins-mcp/packages/cli/node_modules:/home/chnguyen/ai/jenkins-mcp/packages/node_modules:/home/chnguyen/ai/jenkins-mcp/node_modules:/home/chnguyen/ai/node_modules:/home/chnguyen/node_modules:/home/node_modules:/node_modules:~/.local/share/pnpm/global/5/.pnpm/node_modules"
else
  export NODE_PATH="/home/chnguyen/ai/jenkins-mcp/packages/cli/dist/node_modules:/home/chnguyen/ai/jenkins-mcp/packages/cli/node_modules:/home/chnguyen/ai/jenkins-mcp/packages/node_modules:/home/chnguyen/ai/jenkins-mcp/node_modules:/home/chnguyen/ai/node_modules:/home/chnguyen/node_modules:/home/node_modules:/node_modules:~/.local/share/pnpm/global/5/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../../../dist/index.js" "$@"
else
  exec node  "$basedir/../../../../dist/index.js" "$@"
fi
