{
  "name": "@cuonghuunguyen/jenkins-mcp",
  "version": "0.2.0",
  "type": "module",
  "description": "MCP server exposing Jenkins read and build-control tools over stdio or HTTP",
  "keywords": [
    "jenkins",
    "mcp",
    "model-context-protocol",
    "ci",
    "ai-agent"
  ],
  "homepage": "https://github.com/cuonghuunguyen/jenkins-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cuonghuunguyen/jenkins-mcp.git",
    "directory": "packages/mcp"
  },
  "bugs": "https://github.com/cuonghuunguyen/jenkins-mcp/issues",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "jenkins-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cuonghuunguyen/jenkins-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
